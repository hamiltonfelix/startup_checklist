# Modelo de ambiente da interface. Copie para `.env.local` e preencha.
# Nenhum valor real entra neste arquivo nem no repositório.
#
# Endereço do projeto Supabase, no formato https://SEU-PROJETO.supabase.co
VITE_SUPABASE_URL=

# Chave pública anônima do projeto Supabase. Ela é pública por natureza,
# mas ainda assim vive só no ambiente, nunca no repositório.
VITE_SUPABASE_ANON_KEY=
